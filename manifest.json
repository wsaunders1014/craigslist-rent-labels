{
  "manifest_version": 3,
  "name": "Craigslist Rent Labels",
  "version": "0.6.0",
  "description": "Show rent on individual Craigslist rental map markers.",
  "content_scripts": [
    {
      "matches": [
        "https://*.craigslist.org/search/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.craigslist.org/search/*"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start",
      "js": [
        "settings-bridge.js"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Rent Labels settings",
    "default_popup": "settings.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
