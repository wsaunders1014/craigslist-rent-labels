{
  "manifest_version": 3,
  "name": "Rent Labels",
  "version": "0.12.0",
  "description": "Show rent and bedrooms on Craigslist, apartments.com and Zillow rental maps, and flag likely rooms and coliving.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.craigslist.org/search/apa*",
        "https://*.craigslist.org/search/hhh*",
        "https://*.craigslist.org/search/roo*",
        "https://*.craigslist.org/search/sub*",
        "https://*.craigslist.org/search/*/apa*",
        "https://*.craigslist.org/search/*/hhh*",
        "https://*.craigslist.org/search/*/roo*",
        "https://*.craigslist.org/search/*/sub*"
      ],
      "js": [
        "src/core.js",
        "src/adapters/craigslist.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.craigslist.org/search/apa*",
        "https://*.craigslist.org/search/hhh*",
        "https://*.craigslist.org/search/roo*",
        "https://*.craigslist.org/search/sub*",
        "https://*.craigslist.org/search/*/apa*",
        "https://*.craigslist.org/search/*/hhh*",
        "https://*.craigslist.org/search/*/roo*",
        "https://*.craigslist.org/search/*/sub*"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start",
      "js": [
        "settings-bridge.js"
      ]
    },
    {
      "matches": [
        "https://www.apartments.com/*"
      ],
      "js": [
        "src/adapters/apartments-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.apartments.com/*"
      ],
      "js": [
        "src/core.js",
        "src/adapters/apartments.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.zillow.com/*"
      ],
      "js": [
        "src/core.js",
        "src/adapters/zillow.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.zillow.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "settings-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Rent Labels settings",
    "default_popup": "settings.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
