{
  "manifest_version": 3,
  "name": "Craigslist Rent Labels",
  "version": "0.10.0",
  "description": "Show rent and bedrooms on Craigslist and apartments.com rental maps, and flag likely rooms and coliving.",
  "content_scripts": [
    {
      "matches": [
        "https://*.craigslist.org/search/apa*",
        "https://*.craigslist.org/search/hhh*",
        "https://*.craigslist.org/search/roo*",
        "https://*.craigslist.org/search/sub*",
        "https://*.craigslist.org/search/*/apa*",
        "https://*.craigslist.org/search/*/hhh*",
        "https://*.craigslist.org/search/*/roo*",
        "https://*.craigslist.org/search/*/sub*"
      ],
      "js": [
        "src/core.js",
        "src/adapters/craigslist.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.craigslist.org/search/apa*",
        "https://*.craigslist.org/search/hhh*",
        "https://*.craigslist.org/search/roo*",
        "https://*.craigslist.org/search/sub*",
        "https://*.craigslist.org/search/*/apa*",
        "https://*.craigslist.org/search/*/hhh*",
        "https://*.craigslist.org/search/*/roo*",
        "https://*.craigslist.org/search/*/sub*"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start",
      "js": [
        "settings-bridge.js"
      ]
    },
    {
      "matches": [
        "https://www.apartments.com/*"
      ],
      "js": [
        "src/adapters/apartments-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.apartments.com/*"
      ],
      "js": [
        "src/core.js",
        "src/adapters/apartments.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Rent Labels settings",
    "default_popup": "settings.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
